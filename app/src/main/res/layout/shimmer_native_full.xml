<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_native"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="#DDDDDD"
        app:shimmer_highlight_color="#F5F5F5">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_native_ads">

            <!-- MEDIA PLACEHOLDER -->
            <View
                android:id="@+id/shimmer_media"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_shimmer_item"
                app:layout_constraintBottom_toTopOf="@+id/shimmer_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- APP ICON PLACEHOLDER -->
            <View
                android:id="@+id/shimmer_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_shimmer_item"
                app:layout_constraintBottom_toTopOf="@+id/shimmer_body"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- AD BADGE PLACEHOLDER -->
            <View
                android:id="@+id/shimmer_badge"
                android:layout_width="24dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_shimmer_item"
                app:layout_constraintStart_toEndOf="@id/shimmer_icon"
                app:layout_constraintTop_toTopOf="@id/shimmer_icon" />

            <!-- HEADLINE PLACEHOLDER -->
            <View
                android:id="@+id/shimmer_headline"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_shimmer_item"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/shimmer_badge"
                app:layout_constraintTop_toTopOf="@id/shimmer_badge" />

            <!-- ADVERTISER PLACEHOLDER -->
            <View
                android:id="@+id/shimmer_advertiser"
                android:layout_width="120dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_shimmer_item"
                app:layout_constraintStart_toStartOf="@id/shimmer_badge"
                app:layout_constraintTop_toBottomOf="@id/shimmer_headline" />

            <!-- BODY PLACEHOLDER -->
            <View
                android:id="@+id/shimmer_body"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_shimmer_item"
                app:layout_constraintBottom_toTopOf="@+id/shimmer_cta"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/shimmer_icon" />

            <!-- CTA PLACEHOLDER -->
            <View
                android:id="@+id/shimmer_cta"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_shimmer_item"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/shimmer_body"
                app:layout_constraintStart_toStartOf="@id/shimmer_body" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>
</layout>
