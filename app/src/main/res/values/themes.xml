<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GPSTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/white</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorSecondary">@color/white</item>
        <item name="android:windowLightStatusBar" tools:ignore="NewApi">true</item>
        <item name="android:statusBarColor">@color/white</item>
    </style>
    <style name="Theme.GPSTrackerLang" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textColorPrimary">#F3F4F6</item>
        <item name="android:textColorSecondary">#F3F4F6</item>
        <item name="colorPrimary">#F3F4F6</item>
        <item name="colorPrimaryDark">#F3F4F6</item>
        <item name="colorSecondary">#F3F4F6</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:ignore="NewApi">true</item>
        <item name="android:statusBarColor">#F3F4F6</item>
    </style>

    <style name="AppAlertDialogStyle" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Title -->
        <item name="android:textColorPrimary">@color/black</item>
        <!-- Message -->
        <item name="android:textColor">@color/black</item>
        <!-- Buttons -->
        <item name="colorAccent">@color/black</item>
        <item name="colorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
    </style>

    <style name="CustomPopupMenu" parent="@style/Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/ic_rounded_bg</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="BottomSheetDialogStyle" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/bottomSheetBackground</item>
    </style>

    <style name="bottomSheetBackground" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_user</item>
    </style>

    <style name="CodePickerStyle" parent="@style/Theme.AppCompat.Dialog.MinWidth">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">350dp</item>
        <item name="background">@drawable/color_picker_bg</item>
        <item name="backgroundColor">@color/white</item>
        <item name="ccpDialog_cornerRadius">10dp</item>
    </style>

    <style name="CustomRadioRight">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Body1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:button">@null</item>
        <item name="android:drawableRight">@drawable/radio_right_selector</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:color">#3e4453</item>
        <item name="android:fontFamily">@font/sfprotext_regular</item>
    </style>
</resources>